{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/docs/",
      "destination": "/docs",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/invite/:token",
      "destination": "/invite"
    },
    {
      "source": "/developer/:path*",
      "destination": "/developer"
    }
  ]
}
